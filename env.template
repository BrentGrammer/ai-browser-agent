# Copy to .env in the repo root. This is the only config file for the Docker setup.

# The app the agent operates on, e.g. https://yourapp.com
TARGET_URL=
OPENAI_API_KEY=

# Everything below is optional. The egress proxy automatically allows
# TARGET_URL's host, the LLM API, and everything listed here.

# Extra domains the agent may deliberately navigate to (comma-separated).
#ALLOWED_NAV_DOMAINS=

# Extra hosts the proxy allows but the agent never navigates to,
# e.g. a CDN the target app loads assets from.
#PROXY_EXTRA_ALLOWED_DOMAINS=

# LLM API host, if not using OpenAI.
#LLM_API_DOMAIN=api.openai.com
