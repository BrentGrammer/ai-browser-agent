# Copy to .env in the repo root. The only config file for the sandboxed Docker setup.

# The app the agent operates on, e.g. https://yourapp.com
TARGET_URL=

# Your LLM provider's API host, e.g. api.openai.com or api.anthropic.com.
LLM_API_DOMAIN=

# API key for the provider above.
OPENAI_API_KEY=

# Optional: extra domains the agent may navigate to (proxy allows them too).
#ALLOWED_NAV_DOMAINS=

# Optional: proxy-only extra hosts, e.g. a CDN the app loads assets from.
#PROXY_EXTRA_ALLOWED_DOMAINS=
